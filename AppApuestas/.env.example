# Obtén estos datos directamente de GanaPlay/Altenar.
# No uses URLs de staging, importer IDs ajenos ni valores de documentación pública.
ALTENAR_DATAFEED_BASE_URL=https://ENDPOINT-AUTORIZADO-ASIGNADO-POR-ALTENAR/Export
ALTENAR_IMPORTER_ID=ID-ASIGNADO-A-GANAPLAY
# Solo si Altenar proporciona un token para este feed:
ALTENAR_DATAFEED_TOKEN=
ALTENAR_TIMEOUT_SECONDS=20
ALTENAR_EVENTS_CACHE_SECONDS=30
ALTENAR_MARKETS_CACHE_SECONDS=30

# Opcional: solo rellenar si Altenar confirma los IDs de deporte del operador.
# Si se dejan vacíos, EdgeBet intenta resolverlos mediante GetSports.
ALTENAR_SPORT_ID_FUTBOL=
ALTENAR_SPORT_ID_NBA=
ALTENAR_SPORT_ID_NFL=
ALTENAR_SPORT_ID_MLB=
