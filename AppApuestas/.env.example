# SportsGameOdds — clave privada del proveedor
# Regístrate en https://sportsgameodds.com/pricing y elige el plan Amateur.
# No guardes la clave real en GitHub ni en la app Flutter.
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_BASE_URL=https://api.sportsgameodds.com/v2
SPORTSGAMEODDS_TIMEOUT_SECONDS=20

# El plan Amateur publica una frecuencia de actualización de 10 minutos.
# La caché del backend evita repetir consultas antes de tiempo.
SPORTSGAMEODDS_CACHE_SECONDS=600
SPORTSGAMEODDS_MARKET_CACHE_SECONDS=600

# Ligas de fútbol incluidas como base en el nivel Amateur.
# Confirma disponibilidad con /leagues de tu cuenta antes de ampliar.
SPORTSGAMEODDS_LEAGUES_FUTBOL=UEFA_CHAMPIONS_LEAGUE,MLS
SPORTSGAMEODDS_LEAGUES_NBA=NBA
SPORTSGAMEODDS_LEAGUES_NFL=NFL
SPORTSGAMEODDS_LEAGUES_MLB=MLB

# PitchAPI — fútbol actual, estadísticas de jugadores, alineaciones, xG y mapas
# Clave gratuita: https://pitchapi.dev/ (mantener solo en Render, nunca en GitHub)
PITCHAPI_API_KEY=
PITCHAPI_CACHE_SECONDS=300

# Protección de la operación de actualización de históricos.
# Sin ADMIN_API_KEY, POST /actualizar-datos queda desactivado (404).
# Crea una clave larga y aleatoria y guárdala solo en Render.
ADMIN_API_KEY=

# Historial persistente opcional en un Supabase asignado a AppApuestas.
# Ejecuta AppApuestas/sql/001_research_snapshots.sql en ese proyecto antes de habilitarlo.
# No uses la clave anon: el backend requiere una service-role key privada.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESEARCH_TABLE=research_snapshots
APP_MODEL_VERSION=research-1
